# Base URL of the Educa_Lara API, including /api.
# Native (Capacitor) builds need an absolute URL the device can reach, e.g.
# https://api.educa.example/api or http://192.168.1.20:8000/api during development.
VITE_API_URL=http://localhost:8000/api

# Continue with Google (optional; the button is hidden until set). OAuth client
# IDs from Google Cloud Console; the API must list the same clients
# (GOOGLE_*_CLIENT_ID in Educa_Lara/.env). The web client needs
# http://localhost:5173 as an authorised JavaScript origin and
# http://localhost:5173/auth/google/callback as an authorised redirect URI.
# Android uses the web client ID too; iOS also needs its own client ID.
VITE_GOOGLE_WEB_CLIENT_ID=
VITE_GOOGLE_IOS_CLIENT_ID=
